import pandas as pd
import matplotlib.pyplot as plt

file_path = "breadprice.csv"  
data = pd.read_csv(file_path)

data = data.dropna()

for col in data.columns[1:]:
    data[col] = pd.to_numeric(data[col], errors='coerce')

data['Average'] = data.iloc[:, 1:].mean(axis=1)

print(data)

plt.figure(figsize=(10, 6))
plt.plot(data['Year'], data['Average'], marker='o', color='b', label='Average Price')
plt.title('Average Bread Price per Year', fontsize=16)
plt.xlabel('Year', fontsize=12)
plt.ylabel('Average Price', fontsize=12)
plt.grid(True)
plt.legend()
plt.xticks(data['Year'], rotation=45)
plt.tight_layout()

plt.show()
