"""
File: hoopstatsapp.py

The application for analyzing basketball stats.
"""

from hoopstatsview import HoopStatsView
import pandas as pd

def cleanStats(data_frame):
 
    columns_to_split = ['FG', '3PT', 'FT']
    new_columns = []  

    for col in columns_to_split:
        makes_attempts = data_frame[col].str.split('-', expand=True)
        
        makes = makes_attempts[0].astype(int)
        attempts = makes_attempts[1].astype(int)

        makes_col = col + 'M' 
        attempts_col = col + 'A' 

        data_frame[makes_col] = makes
        data_frame[attempts_col] = attempts

        new_columns.extend([makes_col, attempts_col])

    data_frame = data_frame.drop(columns=columns_to_split)

    reordered_columns = new_columns + [col for col in data_frame.columns if col not in new_columns]
    data_frame = data_frame[reordered_columns]

    return data_frame

def main():
    """Creates the data frame and view and starts the app."""

    frame = pd.read_csv("cleanbrogdonstats.csv")
    
    frame = cleanStats(frame)
    
    HoopStatsView(frame).mainloop()

if __name__ == "__main__":
    main()
